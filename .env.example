# ===============================================================================
# Basic Agent Environment Configuration
# ===============================================================================

# LLM API Keys
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Langsmith / Langfuse Observability Keys
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=basic-agent
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# Chainlit Authentication Secret (JWT 서명용)
# 아래 명령어로 생성: chainlit create-secret
CHAINLIT_AUTH_SECRET=your_chainlit_secret_here

LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ===============================================================================
# Browser Display Configuration (Navigator Tools)
# ===============================================================================
# HEADLESS: 브라우저 화면 표시 여부
#   true  → 화면 없이 백그라운드 실행 (기본값)
#   false → 브라우저 창을 화면에 표시 (Codespaces noVNC 실습 시 false로 변경)
HEADLESS=true

# DISPLAY: headed 모드(HEADLESS=false)에서 브라우저를 표시할 디스플레이
#   Codespaces + noVNC 환경: ":1" 사용 (bash start_vnc.sh 실행 필요)
#   로컬 데스크톱(WSLg GUI 등): 주석 처리(#)하여 시스템 기본 디스플레이 사용
DISPLAY=":1"